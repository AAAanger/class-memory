# 复制这个文件成 .env.local，再填上你自己的值。
# .env.local 只在服务端读取，不会被打进前端代码，也不会被提交到 git。

# 模型服务的「OpenAI 兼容」地址（各家的值见 docs/识别课表截图.md）
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 你的 API Key
AI_API_KEY=sk-替换成你的Key

# 模型名
AI_MODEL=qwen-vl-max

# 演示模式：设成 1 就不调模型，直接返回内置课表，用来先看界面效果
# TIMETABLE_MOCK=1
